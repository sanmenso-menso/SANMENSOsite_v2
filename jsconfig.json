{
  "compilerOptions": {
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "checkJs": false,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "noImplicitAny": false,
    "maxNodeModuleJsDepth": 0,
    "skipLibCheck": true,
    "strict": false,
    "target": "ES2022",
    "types": ["vite/client", "node"]
  },
  "include": ["src", "scripts", "tests", "*.config.js"]
}
